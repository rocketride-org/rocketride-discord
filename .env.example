# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this template mirrors it so a fresh checkout knows what to set.

# --- Showcase moderator (showcase.js) ---
SHOWCASE_BOT_TOKEN=
SHOWCASE_CLIENT_ID=
SHOWCASE_GUILD_ID=
SHOWCASE_CHANNEL_ID=

# --- Mac Mini host access (ops only; not used by the bots) ---
MAC_MINI_ADMIN_PASSWORD=
MAC_MINI_BOT_USER_PASSWORD=

# --- RocketRide support bot / Rocket Ralph (support.ts) — LOCAL engine, webhook + multi-modal ---
# Runs rocket-ralph.pipe + summariser.pipe on the LOCAL engine; support.ts auto-detects the
# engine's dynamic port, so no URI is needed normally. Qdrant is local (127.0.0.1:6333) — no key.
# ROCKETRIDE_URI=http://localhost:5565   # optional override of the auto-detected engine URI
ROCKETRIDE_APIKEY=                        # local engine API key (if the engine requires one)
SUPPORT_BOT_TOKEN=                        # Rocket Ralph Discord bot token
SUPPORT_CHANNEL_ID=                       # the support channel to listen in
# SUPPORT_MENTION_CHANNEL_ID=             # optional "guest" channel: answers only when @-mentioned
# Used by rocket-ralph.pipe: OpenAI (agent LLM) + GitHub PAT (read-only GitHub tools).
ROCKETRIDE_OPENAI_KEY=
ROCKETRIDE_GITHUB_TOKEN=
# Slack escalation routing (slack-router.ts): when Ralph escalates a thread, page the
# right owner(s) in Slack. Set the webhook to enable it; unset = feature off (no-op).
# The expert directory lives in data/slack-experts.json (gitignored; see .example).
# Classification runs on the LOCAL ENGINE via a separate nano-model pipeline
# (pipelines/slack-classifier.pipe), started lazily on first escalation; its LLM node
# uses ${ROCKETRIDE_OPENAI_KEY} above. The model is set IN the pipe (profile openai-5-4-nano).
SUPPORT_SLACK_WEBHOOK_URL=                 # https://hooks.slack.com/services/… (Incoming Webhook)
# SUPPORT_SLACK_DIRECTORY=data/slack-experts.json          # override directory path
# SUPPORT_SLACK_CLASSIFIER_PIPE=pipelines/slack-classifier.pipe   # override classifier pipeline path
# Manual "Escalate to Slack" message command (right-click a message → Apps). Usable by anyone with
# the @RocketRide team role (SUPPORT_ESCALATION_ROLE_ID) plus any user IDs listed here. Reply is
# ephemeral (private to the invoker). Bot must be invited with the applications.commands scope.
# SUPPORT_ESCALATE_USER_IDS=                # optional extra Discord user IDs (comma-separated)

# --- RocketRide support TEST bot (support-test.ts) — test channel → CLOUD pipeline via webhook ---
# Posts to pipelines DEPLOYED on RocketRide Cloud via their webhook endpoints (HTTP POST, pk_ auth).
SUPPORT_TEST_CHANNEL_ID=
SUPPORT_TEST_WEBHOOK_URL=https://api.rocketride.ai/webhook
SUPPORT_TEST_WEBHOOK_KEY=                  # pk_… — ralph pipeline (per-modality processing)
SUPPORT_TEST_SUMMARISER_KEY=              # pk_… — summariser pipeline (merges multi-part results)
# SUPPORT_TEST_BOT_TOKEN=                 # blank → reuses SUPPORT_BOT_TOKEN (same Rocket Ralph bot)

# --- RocketRide FAQ builder (faq.ts) — scans channels → agent_rocketride → data/faqs.json ---
# Runs faq-builder.pipe on the LOCAL engine (auto-detected port, like support.ts). Reuses
# ROCKETRIDE_OPENAI_KEY above for the agent's LLM. A nightly batch clusters/dedupes/categorizes
# FAQ-worthy questions and writes the full list to FAQ_STORE_PATH for the website to read.
FAQ_CHANNEL_IDS=                          # comma-separated channel IDs to scan for questions
FAQ_BOT_TOKEN=                            # bot in the server w/ Read Message History + Message Content intent; blank → SCHEDULER_BOT_TOKEN
# FAQ_CRON_HOURS=3                        # hours 0-23 (Pacific) to run; default 03:00 nightly
# FAQ_TZ=America/Los_Angeles              # IANA timezone (default)
# FAQ_STORE_PATH=data/faqs.json          # where the FAQ JSON is written (default)
# FAQ_STATE_PATH=logs/faq-seen.json      # per-channel watermark store (default)
# FAQ_MAX_MESSAGES=100                    # max messages read per channel per run (default/cap 100)

# --- Rocket Ralph EVAL system (eval/main.ts) — measures Ralph's support resolution ---
# Separate process + separate bot. Grades quiet #support threads, posts review cards to a
# private review channel, runs the weekly golden-set replay. See eval/PHASE0.md.
EVAL_BOT_TOKEN=                            # NEW bot app (not Ralph's); intents: Guilds, GuildMessages, MessageContent, GuildMembers
EVAL_REVIEW_CHANNEL_ID=                    # private channel, @RocketRide team only; eval bot needs View+Send+Embed there
EVAL_RALPH_BOT_ID=                         # Ralph's bot user id (backfill keeps only threads Ralph opened)
EVAL_TEAM_USER_IDS=                        # comma-separated Discord user IDs treated as team (in addition to the role)
EVAL_RETRIEVE_PIPE=pipelines/eval-retrieve.pipe   # retrieval-analysis pipe (queries ROCKETRIDE_DOCS_EVAL)
# EVAL_DB_PATH=logs/ralph-eval.sqlite
# EVAL_FEEDBACK_REACTIONS=false            # Ralph adds ✅/❌ to answers (Phase 1; off until Joshua decides)
# EVAL_QUIET_HOURS=48
# EVAL_REASK_DAYS=14
# EVAL_WINDOW_DAYS=28
# EVAL_MATCH_SCORE=0.7
# EVAL_TZ=America/Los_Angeles
# EVAL_GRADE_HOUR=1

# --- Discord Post Scheduler (scheduler.ts; needs Redis) ---
SCHEDULER_BOT_TOKEN=
SCHEDULER_GUILD_ID=
# REDIS_URL=redis://127.0.0.1:6379   # optional, this is the default

# --- Social feed announcer (social.ts) ---
# How many latest items to consider per source (default 5)
SOCIAL_FETCH_LIMIT=5
# Schedule (defaults shown) — hours 0-23 + IANA timezone
# SOCIAL_CRON_HOURS=9,10,11,16,17,18
# SOCIAL_TZ=America/Los_Angeles

# Newsletter (Ghost) — read-only Content API
GHOST_API_URL=https://your-site.ghost.io
GHOST_CONTENT_API_KEY=
# GHOST_ADMIN_KEY=                   # not needed for read-only fetching

# X / Twitter (official API v2) — bearer token + numeric user id are what the fetcher uses
X_BEARER_TOKEN=
X_USER_ID=
X_USERNAME=
# X_EXCLUDE_REPLIES=true            # optional (default true) — excludes comments
# X_EXCLUDE_RETWEETS=true           # optional (default true) — excludes reposts
# OAuth 1.0a creds — only for future write access, unused by read fetch
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# YouTube — Data API v3 key + channel id
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# YOUTUBE_HANDLE=@yourhandle         # alternative to the channel id

# Instagram — Meta Graph API (Business/Creator account)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_API_VERSION=v22.0        # optional (default v22.0)

# LinkedIn — Community Management API. A refresh token is exchanged for an access token each run
# via the client id+secret (access tokens expire ~60d). Only original posts are announced (reshares filtered).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=               # the refresh token; exchanged via client id+secret each run
LINKEDIN_ORG_ID=                     # numeric company-page id → urn:li:organization:{id}
# LINKEDIN_REFRESH_TOKEN=            # alt to putting the refresh token in LINKEDIN_ACCESS_TOKEN
# LINKEDIN_AUTHOR_URN=               # alt to LINKEDIN_ORG_ID (full urn:li:person/organization)
# LINKEDIN_API_VERSION=202508        # LinkedIn-Version header (YYYYMM); bump if it 426s

# Where the announcer posts
SOCIAL_DISCORD_CHANNEL_ID=
# SOCIAL_DISCORD_TOKEN=              # optional; defaults to SCHEDULER_BOT_TOKEN
# Dedicated announcer bot (not used yet — the scheduler bot posts for now)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=

# --- Eval model bake-off (eval/bench/) — OPTIONAL, nothing in production reads these ---
# Compares grader models on cost + label agreement. `--estimate` needs no key at all.
# The OpenAI arms already work: they fall back to ROCKETRIDE_OPENAI_KEY above.
# Add only the providers you actually want to bake off.
# ANTHROPIC_API_KEY=      # Sonnet 5 / Haiku 4.5 arms — console.anthropic.com
# GROQ_API_KEY=           # GPT-OSS 120B / 20B arms — console.groq.com
# XAI_API_KEY=            # Grok 4.1 Fast arm — console.x.ai
# DEEPSEEK_API_KEY=       # DeepSeek V4.1 Flash arm — platform.deepseek.com
# OPENROUTER_API_KEY=     # one key, any model — see the openrouter template in pricing.json
# Tunables (defaults shown)
# BENCH_CATALOG=eval/bench/pricing.json
# BENCH_OUT_DIR=logs/bench
# BENCH_GOLD=logs/bench/gold.jsonl
# BENCH_CONCURRENCY=3
# BENCH_TIMEOUT_MS=120000
# BENCH_MAX_RETRIES=3

# --- Arm A / Arm C bake-off (eval/bakeoff/) — OPTIONAL, nothing in production reads these ---
# Arm A: Claude Sonnet 5 does grader + judge + reason.
# Arm C: Jev (TypeSafe System One) decides, escalating low-confidence calls to Sonnet 5.
#
# ONE key runs both arms: OpenRouter fronts Sonnet 5 (chat-completions) AND Jev
# (POST /api/v1/systemone), and returns usage.cost per response so cost is measured, not estimated.
# OPENROUTER_API_KEY=       # https://openrouter.ai/settings/keys  — needs credit on the account
# Already-present alternative: if OPENJEV_API_KEY is an OpenRouter key, the harness will use it.
#
# Optional: only if you swap the raw-HTTP client for the official TypeSafe SDK.
# TYPESAFE_BASE_URL=https://openrouter.ai/api
#
# Optional: run Arm A against Anthropic directly instead of through OpenRouter.
# Costs the same list price, but Anthropic returns tokens only — prices then come from
# OpenRouter's models API at run start rather than from the response itself.
# ANTHROPIC_API_KEY=
